foreach(asset GENERATOR X64_HELPER X86_HELPER EFFECT INSTRUMENT)
    if(NOT EXISTS "${${asset}}")
        message(FATAL_ERROR "Missing ${asset}. Build both source architectures before staging.")
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}/runtime/x64" "${DESTINATION}/runtime/x86" "${DESTINATION}/notices")
file(COPY_FILE "${GENERATOR}" "${DESTINATION}/NyteraVST2Wrapper.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${X64_HELPER}" "${DESTINATION}/runtime/x64/NyteraBridge.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${X86_HELPER}" "${DESTINATION}/runtime/x86/NyteraBridge.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${EFFECT}" "${DESTINATION}/runtime/Effect.vst3" ONLY_IF_DIFFERENT)
file(COPY_FILE "${INSTRUMENT}" "${DESTINATION}/runtime/Instrument.vst3" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/LICENSE.md" "${DESTINATION}/notices/JUCE-LICENSE.md" ONLY_IF_DIFFERENT)
file(COPY_FILE "${VST2}/LICENSE" "${DESTINATION}/notices/Xaymar-vst2sdk-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_audio_processors_headless/format_types/VST3_SDK/LICENSE.txt" "${DESTINATION}/notices/VST3-SDK-LICENSE.txt" ONLY_IF_DIFFERENT)
message(STATUS "Staged Nytera application in ${DESTINATION}")
