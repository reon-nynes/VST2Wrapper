foreach(asset GENERATOR X64_HELPER X86_HELPER EFFECT INSTRUMENT)
    if(NOT EXISTS "${${asset}}")
        message(FATAL_ERROR "Missing ${asset}. Build both source architectures before staging.")
    endif()
endforeach()
file(MAKE_DIRECTORY "${DESTINATION}/runtime/x64" "${DESTINATION}/runtime/x86" "${DESTINATION}/notices")
file(COPY_FILE "${GENERATOR}" "${DESTINATION}/NyteraVST2Wrapper.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${X64_HELPER}" "${DESTINATION}/runtime/x64/NyteraBridge.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${X86_HELPER}" "${DESTINATION}/runtime/x86/NyteraBridge.exe" ONLY_IF_DIFFERENT)
file(COPY_FILE "${EFFECT}" "${DESTINATION}/runtime/Effect.vst3" ONLY_IF_DIFFERENT)
file(COPY_FILE "${INSTRUMENT}" "${DESTINATION}/runtime/Instrument.vst3" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/LICENSE.md" "${DESTINATION}/notices/JUCE-LICENSE.md" ONLY_IF_DIFFERENT)
file(COPY_FILE "${VST2}/LICENSE" "${DESTINATION}/notices/Xaymar-vst2sdk-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_audio_processors_headless/format_types/VST3_SDK/LICENSE.txt" "${DESTINATION}/notices/VST3-SDK-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_core/zip/zlib/LICENSE" "${DESTINATION}/notices/zlib-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_graphics/fonts/harfbuzz/COPYING" "${DESTINATION}/notices/HarfBuzz-COPYING.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_graphics/image_formats/pnglib/LICENSE" "${DESTINATION}/notices/libpng-LICENSE.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_graphics/image_formats/jpglib/README" "${DESTINATION}/notices/libjpeg-README.txt" ONLY_IF_DIFFERENT)
file(COPY_FILE "${JUCE}/modules/juce_graphics/unicode/sheenbidi/LICENSE" "${DESTINATION}/notices/SheenBidi-LICENSE.txt" ONLY_IF_DIFFERENT)
get_filename_component(sourceRoot "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(MAKE_DIRECTORY "${DESTINATION}/LICENSES")
file(COPY_FILE "${sourceRoot}/LICENSE" "${DESTINATION}/LICENSE" ONLY_IF_DIFFERENT)
file(COPY_FILE "${sourceRoot}/LICENSES/AGPL-3.0-only.txt" "${DESTINATION}/LICENSES/AGPL-3.0-only.txt" ONLY_IF_DIFFERENT)
file(MAKE_DIRECTORY "${DESTINATION}/docs/testing")
file(COPY_FILE "${sourceRoot}/README.md" "${DESTINATION}/README.md" ONLY_IF_DIFFERENT)
file(COPY_FILE "${sourceRoot}/docs/testing/reaper-acceptance.md" "${DESTINATION}/docs/testing/reaper-acceptance.md" ONLY_IF_DIFFERENT)
message(STATUS "Staged Nytera application in ${DESTINATION}")
