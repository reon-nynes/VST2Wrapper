find_package(Git REQUIRED)
function(nytera_dependency name url revision)
    set(destination "${PROJECT_SOURCE_DIR}/out/deps/${name}")
    if(NOT EXISTS "${destination}/.git")
        execute_process(COMMAND "${GIT_EXECUTABLE}" init "${destination}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${destination}" remote add origin "${url}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${destination}" fetch --depth 1 origin "${revision}" COMMAND_ERROR_IS_FATAL ANY)
        execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${destination}" checkout --detach FETCH_HEAD COMMAND_ERROR_IS_FATAL ANY)
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${destination}" rev-parse HEAD OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT actual STREQUAL revision)
        message(FATAL_ERROR "${name} revision mismatch: ${actual}")
    endif()
    set(${name}_SOURCE_DIR "${destination}" PARENT_SCOPE)
endfunction()
nytera_dependency(vst2sdk https://github.com/Xaymar/vst2sdk.git 339d4f31590bf77c0d0d248e09a380ac6285e069)
